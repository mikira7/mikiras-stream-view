{
  "id": "mikiras-stream-view",
  "title": "Mikira's Stream View",
  "description": "A common display for streaming Foundry games: hides the UI on a dedicated stream user and splits the screen into panes, each showing a different token's point of view, the party, the GM's camera or the whole scene.",
  "version": "0.1.0",
  "authors": [{ "name": "Mikira", "url": "https://github.com/mikira7" }],
  "url": "https://github.com/mikira7/mikiras-stream-view",
  "manifest": "https://github.com/mikira7/mikiras-stream-view/releases/latest/download/module.json",
  "download": "https://github.com/mikira7/mikiras-stream-view/releases/download/v0.1.0/module.zip",
  "readme": "https://github.com/mikira7/mikiras-stream-view#readme",
  "bugs": "https://github.com/mikira7/mikiras-stream-view/issues",
  "license": "LICENSE",
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "socket": true,
  "esmodules": ["scripts/main.js"],
  "styles": ["styles/stream-view.css"],
  "languages": [
    { "lang": "en", "name": "English", "path": "lang/en.json" }
  ],
  "relationships": {
    "recommends": [
      { "id": "lib-wrapper", "type": "module" }
    ]
  }
}
